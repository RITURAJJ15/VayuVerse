# ── VayuVerse Environment Variables ──────────────────────────
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# OpenAQ v3 — register at https://openaq.org/register
OPENAQ_API_KEY=

# Google Gemini — get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouteService (ORS) — register at https://openrouteservice.org
OPENROUTESERVICE_API_KEY=

# Supabase Client-side (Public publishable key protected by RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
